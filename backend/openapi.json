  "info": {
    "description": "本地知识库后端服务。业务接口统一返回 {code,message,data,request_id} 信封。",
    "title": "Personal Knowledge Base API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "_read_health_api_v1_health_get",
