{
  "components": {
    "schemas": {
      "CapabilitiesOut": {
        "description": "What the local installation can currently do.",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/ModelCapability"
          },
          "privacy": {
            "$ref": "#/components/schemas/PrivacyInfo"
          },
          "storage": {
            "$ref": "#/components/schemas/StorageInfo"
          },
          "vector": {
            "$ref": "#/components/schemas/VectorCapability"
          }
        },
        "required": [
          "model",
          "vector",
          "storage",
          "privacy"
        ],
        "title": "CapabilitiesOut",
        "type": "object"
      },
      "Envelope_CapabilitiesOut_": {
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CapabilitiesOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "Envelope[CapabilitiesOut]",
        "type": "object"
      },
      "Envelope_SystemInfoOut_": {
        "properties": {
          "code": {
            "default": 0,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SystemInfoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "default": "ok",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "Envelope[SystemInfoOut]",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Failure envelope returned by the global exception handlers.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "title": "Data",
            "type": "null"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "description": "Liveness payload; health is exempt from the envelope.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "ModelCapability": {
        "properties": {
          "configured": {
            "default": false,
            "title": "Configured",
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "title": "ModelCapability",
        "type": "object"
      },
      "PrivacyInfo": {
        "properties": {
          "allow_external_calls": {
            "default": false,
            "title": "Allow External Calls",
            "type": "boolean"
          }
        },
        "title": "PrivacyInfo",
        "type": "object"
      },
      "StorageInfo": {
        "properties": {
          "free_bytes": {
            "title": "Free Bytes",
            "type": "integer"
          },
          "total_bytes": {
            "title": "Total Bytes",
            "type": "integer"
          }
        },
        "required": [
          "free_bytes",
          "total_bytes"
        ],
        "title": "StorageInfo",
        "type": "object"
      },
      "SystemInfoOut": {
        "description": "Runtime information about the local backend.",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "backend_version": {
            "title": "Backend Version",
            "type": "string"
          },
          "data_dir": {
            "title": "Data Dir",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "python_version": {
            "title": "Python Version",
            "type": "string"
          }
        },
        "required": [
          "app_version",
          "backend_version",
          "api_version",
          "python_version",
          "platform",
          "data_dir",
          "environment"
        ],
        "title": "SystemInfoOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VectorCapability": {
        "properties": {
          "indexed_items": {
            "default": 0,
            "title": "Indexed Items",
            "type": "integer"
          },
          "ready": {
            "default": false,
            "title": "Ready",
            "type": "boolean"
          }
        },
        "title": "VectorCapability",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "本地知识库后端服务。业务接口统一返回 {code,message,data,request_id} 信封。",
    "title": "Personal Knowledge Base API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "_read_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "存活检查",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "description": "Return what the local installation can currently do.",
        "operationId": "system_capabilities_api_v1_system_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_CapabilitiesOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "未认证"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "服务未就绪"
          }
        },
        "summary": "当前能力：模型、向量库、存储、隐私开关",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/info": {
      "get": {
        "description": "Return version and data directory information.",
        "operationId": "system_info_api_v1_system_info_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_SystemInfoOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "未认证"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "服务未就绪"
          }
        },
        "summary": "应用与后端版本信息",
        "tags": [
          "system"
        ]
      }
    }
  }
}
