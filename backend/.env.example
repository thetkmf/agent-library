# 本地后端开发环境变量：复制为 .env 使用，禁止提交 .env
# 启动契约（Electron 主进程注入，见《开发过程》接口变更记录）
PKB_TOKEN=replace-with-32-byte-random-token
PKB_HOST=127.0.0.1
PKB_PORT=8765
PKB_LOG_LEVEL=INFO
# 日志同时写文件时指定（打包运行时由主进程写入用户目录）
# PKB_LOG_FILE=D:\\data\\PersonalKnowledgeBase\\logs\\backend.log
# 数据目录默认 %APPDATA%\\PersonalKnowledgeBase，需要改时取消下一行注释
# PKB_DATA_DIR=D:\\data\\PersonalKnowledgeBase
PKB_PRIVACY_ALLOW_EXTERNAL_CALLS=false
